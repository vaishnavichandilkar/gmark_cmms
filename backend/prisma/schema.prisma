generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Society {
  id        Int        @id @default(autoincrement())
  name      String
  city      String
  buildings Building[]
  users     User[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

enum UserRole {
  SUPER_ADMIN
  SOCIETY_ADMIN
  BUILDING_ADMIN
  OPERATOR
  VIEWER
}

model User {
  id              Int              @id @default(autoincrement())
  username        String           @unique
  mobileNumber    String?
  email           String           @unique
  password        String
  plainPassword   String?
  firstName       String?
  lastName        String?
  fullName        String?
  designation     String?
  profileTitle    String?
  profileDetail   String?
  profileImageUrl String?
  floorNo         String?
  city            String?
  state           String?
  country         String?
  pincode         String?
  role            UserRole         @default(VIEWER)
  moduleAccess    String           @default("BOTH")
  isActive        Boolean          @default(true)
  societyId       Int?
  society         Society?         @relation(fields: [societyId], references: [id], onDelete: Cascade)
  employeeId      Int?
  employee        Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  mainFacilityId  Int?
  mainFacility    MainFacility?    @relation(fields: [mainFacilityId], references: [id], onDelete: SetNull)
  facilityId      Int?
  facility        Facility?        @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  adminId         Int?
  admin           User?            @relation("AdminUsers", fields: [adminId], references: [id], onDelete: SetNull)
  createdUsers    User[]           @relation("AdminUsers")
  deviceId        String?
  deviceName      String?
  registration    Registration?
  buildings       UserBuilding[]
  userPermissions UserPermission[]
  refreshToken    String?
  createdWorkOrders  WorkOrder[]          @relation("WOCreator")
  assignedWorkOrders WorkOrder[]          @relation("WOAssignedTech")
  approvedWorkOrders WorkOrder[]          @relation("WOApprover")
  level3ApprovedWorkOrders WorkOrder[]    @relation("WOLevel3Approver")
  workOrderRevisions WorkOrderRevision[]
  assignedScheduleTasks MaintenanceScheduleTask[]
  userCheckpoints UserCheckpoint[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Registration {
  id               Int      @id @default(autoincrement())
  companyName      String
  businessCategory String?
  gstNumber        String   @unique
  address          String?
  city             String?
  state            String?
  country          String?
  zipCode          String?
  postalCode       String?
  userId           Int      @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model UserBuilding {
  id         Int      @id @default(autoincrement())
  userId     Int
  buildingId Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([userId, buildingId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  module    String
  ipAddress String
  createdAt DateTime @default(now())
}

model Building {
  id             Int           @id @default(autoincrement())
  name           String
  info           String?       @default("0F - 0 flats")
  societyId      Int?
  society        Society?      @relation(fields: [societyId], references: [id], onDelete: Cascade)
  mainFacilityId Int?
  mainFacility   MainFacility? @relation(fields: [mainFacilityId], references: [id], onDelete: Cascade)
  devices        Device[]
  machines       Machine[]
  users          UserBuilding[]
}

model Device {
  id         Int     @id @default(autoincrement())
  deviceId   String  @unique
  name       String
  template   String?
  systemName String?
  cardNo     String?
  topic      String?
  buildingId Int?

  // Frontend integration fields
  application String? @default("DOMESTIC_WATER_SYS")
  pumpType    String? @default("WMP_BOOSTER_PUMP")
  controller  String? @default("AIPCU")
  macType     String? @default("Primary MAC")

  building Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  latestData Json?
  lastSeen   DateTime?

  // Historical Logging Configuration
  historyEnabled  Boolean   @default(false)
  historyMode     String    @default("Time-based") // 'Time-based' | 'Conditional'
  historyInterval String    @default("minute")     // 'minute' | 'hour' | 'day'
  lastHistoryAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registerValues DeviceRegisterValue[]
  alerts         DeviceAlert[]
  alertConfigs   RegisterAlertConfig[]
}

model DeviceSnapshot {
  id          Int      @id @default(autoincrement())
  deviceId    String
  historyMode String?  @default("Time-based")
  payload     Json
  createdAt   DateTime @default(now())

  @@index([deviceId, createdAt])
  @@index([createdAt])
}

model DeviceState {
  id                   Int      @id @default(autoincrement())
  deviceId             String   @unique
  deviceActive         Boolean  @default(false)
  motor1Status         Boolean  @default(false)
  motor2Status         Boolean  @default(false)
  motor3Status         Boolean  @default(false)
  motor4Status         Boolean  @default(false)
  motor1ConfigActivate Boolean  @default(false)
  motor2ConfigActivate Boolean  @default(false)
  motor3ConfigActivate Boolean  @default(false)
  motor4ConfigActivate Boolean  @default(false)
  inputPowerFaultType  Int      @default(0)
  averageVoltage       Float    @default(0)
  ryVoltage            Float    @default(0)
  ybVoltage            Float    @default(0)
  rbVoltage            Float    @default(0)
  motor1RCurrent       Float    @default(0)
  motor1YCurrent       Float    @default(0)
  motor1BCurrent       Float    @default(0)
  motor2RCurrent       Float    @default(0)
  motor2YCurrent       Float    @default(0)
  motor2BCurrent       Float    @default(0)
  motor3RCurrent       Float    @default(0)
  motor3YCurrent       Float    @default(0)
  motor3BCurrent       Float    @default(0)
  motor4RCurrent       Float    @default(0)
  motor4YCurrent       Float    @default(0)
  motor4BCurrent       Float    @default(0)
  waterAvailable       Boolean  @default(false)
  pressureSwitch1      Boolean  @default(false)
  pressureSwitch2      Boolean  @default(false)
  pressureSwitch3      Boolean  @default(false)
  pressureSwitch4      Boolean  @default(false)
  pressureSwitch5      Boolean  @default(false)
  pressureBar          Float    @default(0)
  transmitterConnected Boolean  @default(false)
  pressuremA           Float    @default(0)
  pumpOnDelay          Int      @default(0)
  nextFillingTime      Int      @default(0)
  overloadResetDelay   Int      @default(0)
  underloadResetDelay  Int      @default(0)
  vfdResetAfter        Int      @default(0)
  pressureTankPressure Float    @default(0)
  tankStatus           Boolean  @default(false)
  pump1FaultType       Int      @default(0)
  pump2FaultType       Int      @default(0)
  pump3FaultType       Int      @default(0)
  pump4FaultType       Int      @default(0)
  motor1RunTime        Int      @default(0)
  motor2RunTime        Int      @default(0)
  motor3RunTime        Int      @default(0)
  motor4RunTime        Int      @default(0)

  // Fire Panel specific fields
  line1JockeyAuto       Int @default(0)
  line1JockeyManual     Int @default(0)
  line1JockeyOn         Int @default(0)
  line1JockeyTrip       Int @default(0)
  line1JockeyControlOff Int @default(0)
  line1JockeyControlOn  Int @default(0)

  line1MainAuto         Int @default(0)
  line1MainManual       Int @default(0)
  line1MainOn           Int @default(0)
  line1MainTrip         Int @default(0)
  line1MainControlOff   Int @default(0)
  line1MainControlOn    Int @default(0)

  line2JockeyAuto       Int @default(0)
  line2JockeyManual     Int @default(0)
  line2JockeyOn         Int @default(0)
  line2JockeyTrip       Int @default(0)
  line2JockeyControlOff Int @default(0)
  line2JockeyControlOn  Int @default(0)

  line2MainAuto         Int @default(0)
  line2MainManual       Int @default(0)
  line2MainOn           Int @default(0)
  line2MainTrip         Int @default(0)
  line2MainControlOff   Int @default(0)
  line2MainControlOn    Int @default(0)

  terraceBooster1Auto       Int @default(0)
  terraceBooster1Manual     Int @default(0)
  terraceBooster1On         Int @default(0)
  terraceBooster1Trip       Int @default(0)
  terraceBooster1ControlOff Int @default(0)
  terraceBooster1ControlOn  Int @default(0)

  terraceBooster2Auto       Int @default(0)
  terraceBooster2Manual     Int @default(0)
  terraceBooster2On         Int @default(0)
  terraceBooster2Trip       Int @default(0)
  terraceBooster2ControlOff Int @default(0)
  terraceBooster2ControlOn  Int @default(0)

  dieselEngineAuto       Int @default(0)
  dieselEngineManual     Int @default(0)
  dieselEngineOn         Int @default(0)
  dieselEngineControlOff Int @default(0)
  dieselEngineControlOn  Int @default(0)

  // Additional fields from handwritten notes
  dgControlOn            Int @default(0)
  line1MainOff           Int @default(0)
  line2MainOff           Int @default(0)
  line1JockeyOff         Int @default(0)
  dgAuto                 Int @default(0)
  dgManual               Int @default(0)
  uzLine1Pressure        Float @default(0)
  uzLine2Pressure        Float @default(0)

  updatedAt            DateTime @updatedAt
}

model RegisterDefinition {
  id          Int      @id @default(autoincrement())
  address     Int      @unique // Array Index (0, 1, 2, etc.)
  name        String
  range       String?
  description String?
  units       String?
  mappedKey   String? // The key to update in DeviceState/Frontend
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deviceValues DeviceRegisterValue[]
}

model DeviceRegisterValue {
  id         Int      @id @default(autoincrement())
  deviceId   String
  registerId Int
  value      Float
  updatedAt  DateTime @updatedAt

  register RegisterDefinition @relation(fields: [registerId], references: [id])
  device   Device             @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)

  @@unique([deviceId, registerId])
}

model Employee {
  id            Int       @id @default(autoincrement())
  employeeCode  String?
  fullName      String
  mobileNumber  String
  officialEmail String?
  personalEmail String?
  dateOfJoining DateTime?
  dateOfBirth   DateTime?
  department    String?
  designation   String
  salaryPayout  Float?
  reportingTo   String?
  adminId       Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  users         User[]

  @@unique([adminId, employeeCode])
}

model MainFacility {
  id               Int        @id @default(autoincrement())
  mainFacilityCode String     @unique
  mainFacilityName String
  mainFacilityHead String
  gstNumber        String?
  category         String
  subcategory      String
  status           String
  description      String?
  latitude         String?
  longitude        String?
  postalCode       String?
  address          String?
  country          String?
  state            String?
  city             String?
  adminId          Int?
  users            User[]
  facilities       Facility[]
  buildings        Building[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Facility {
  id           Int     @id @default(autoincrement())
  facilityCode String  @unique
  facilityName String
  category     String
  description  String?
  adminId      Int?

  // Location & Hierarchy Fields
  isLocationPart   Boolean    @default(false)
  parentFacilityId Int?
  parentFacility   Facility?  @relation("FacilityHierarchy", fields: [parentFacilityId], references: [id])
  childFacilities  Facility[] @relation("FacilityHierarchy")

  address          String?
  country          String?
  state            String?
  city             String?
  postalCode       String?
  subCategory      String?
  latitude         String?
  longitude        String?
  facilityHeadName String?
  notes            String?

  mainFacilityId Int
  mainFacility   MainFacility @relation(fields: [mainFacilityId], references: [id], onDelete: Cascade)
  machines       Machine[]
  users          User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Designation {
  id          Int          @id @default(autoincrement())
  name        String
  isActive    Boolean      @default(true)
  adminId     Int?
  permissions Permission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id            Int         @id @default(autoincrement())
  designationId Int
  moduleId      String
  canView       Boolean     @default(false)
  canCreate     Boolean     @default(false)
  canEdit       Boolean     @default(false)
  canDelete     Boolean     @default(false)
  canImport     Boolean     @default(false)
  canExport     Boolean     @default(false)
  canPrint      Boolean     @default(false)
  designation   Designation @relation(fields: [designationId], references: [id], onDelete: Cascade)

  @@unique([designationId, moduleId])
}

model UserPermission {
  id        Int     @id @default(autoincrement())
  userId    Int
  moduleId  String
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)
  canImport Boolean @default(false)
  canExport Boolean @default(false)
  canPrint  Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
}

model PostalCode {
  id        Int      @id @default(autoincrement())
  pincode   String   @unique
  city      String
  state     String
  country   String   @default("India")
  createdAt DateTime @default(now())

  @@index([pincode])
}

model CodeSequence {
  id        String   @id
  prefix    String
  lastValue Int      @default(0)
  padding   Int      @default(3)
  updatedAt DateTime @updatedAt
}

model Machine {
  id       Int     @id @default(autoincrement())
  name     String
  deviceId String? @unique // Link to Device (MAC ID) for IoT data
  adminId  Int?

  machineType        String? // e.g. 'HYPN', 'FIRE', 'STP', 'WTP', 'SUMP', etc.
  company            String?
  maintenanceHead    String?
  machineCode        String?
  serialNumber       String?
  make               String?
  modelNumber        String?
  machineCategory    String?
  machineSubCategory String?
  description        String?
  assetCode          String?
  isLocationPart     Boolean? @default(false)
  costCenter         String?
  headOfDepartment   String?
  machineOwner       String?
  latitude           String?
  longitude          String?
  notes              String?

  buildingId Int?
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  facilityId Int?
  facility   Facility? @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  parentMachineId Int?
  parentMachine   Machine?  @relation("MachineHierarchy", fields: [parentMachineId], references: [id])
  childMachines   Machine[] @relation("MachineHierarchy")

  documents            MachineDocument[]
  specifications       MachineSpecification[]
  workOrders           WorkOrder[]
  checkpoints          MachineCheckpoint[]
  maintenanceSchedules MaintenanceSchedule[]
  userCheckpoints      UserCheckpoint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MachineDocument {
  id        Int      @id @default(autoincrement())
  name      String
  type      String // 'File', 'Link', 'Note'
  content   String // File path, URL, or Note text
  machineId Int
  machine   Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MachineSpecification {
  id        Int      @id @default(autoincrement())
  title     String
  inputType String
  data      String
  unit      String?
  machineId Int
  machine   Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeviceAlert {
  id          Int      @id @default(autoincrement())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
  message     String
  type        String   @default("WARNING") // INFO, WARNING, CRITICAL, EMERGENCY, NOTIFY
  status      String   @default("ACTIVE") // ACTIVE, RESOLVED, ACKNOWLEDGED
  
  triggerKey  String?
  intensity   Int?     @default(1)

  emailSent              Boolean   @default(false)
  emailSentTo            String?
  rolesNotified          String?
  
  // Escalation Matrix Tracking
  isEscalated            Boolean   @default(false)
  escalationLevel        Int       @default(1)
  lastEscalatedAt        DateTime?
  acknowledgedAt         DateTime?
  acknowledgedBy         String?
  
  createdAt              DateTime  @default(now())
  resolvedAt             DateTime?

  @@index([deviceId, status])
}

model RegisterAlertConfig {
  id                        Int      @id @default(autoincrement())
  deviceId                  String
  registerNumber            Int      // Array index / register address
  registerName              String?
  enabled                   Boolean  @default(true)
  alertType                 String   @default("WARNING") // EMERGENCY, WARNING, NOTIFY
  intensity                 Int      @default(1) // 1 to 5
  conditionType             String   // GREATER_THAN, LESS_THAN, EQUAL_TO
  conditionValue            Float
  message                   String
  sendEmail                 Boolean  @default(true)
  emailRecipients           String?  // Comma-separated email addresses
  notifyRoles               String?  @default("SUPER_ADMIN,BUILDING_ADMIN,OPERATOR") // Comma-separated user roles
  
  // Escalation Matrix Policy
  enableEscalation          Boolean  @default(false)
  escalationIntervalMinutes Int      @default(60) // Minutes before escalating to next tier (e.g. 15, 30, 60, 120)
  escalationChain           String?  @default("OPERATOR,BUILDING_ADMIN,SUPER_ADMIN") // Hierarchy order

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  device                    Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)

  @@unique([deviceId, registerNumber])
  @@index([deviceId, enabled])
}

enum WorkOrderStatus {
  PENDING_APPROVAL
  APPROVED
  IN_PROGRESS
  REVISION_REQUESTED
  COMPLETED
  CLOSED
  REJECTED
}

enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model WorkOrder {
  id                 Int               @id @default(autoincrement())
  woNumber           String            @unique
  adminId            Int?
  machineId          Int
  machine            Machine           @relation(fields: [machineId], references: [id], onDelete: Cascade)
  problemDescription String
  priority           WorkOrderPriority @default(MEDIUM)
  status             WorkOrderStatus   @default(PENDING_APPROVAL)
  triggerType        String            @default("MANUAL") // 'MANUAL', 'SCHEDULED', 'MACHINE_CARD'
  
  createdById        Int?
  createdBy          User?             @relation("WOCreator", fields: [createdById], references: [id], onDelete: SetNull)
  creatorName        String?
  creatorEmail       String?
  
  assignedTechnicianId Int?
  assignedTechnician   User?           @relation("WOAssignedTech", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  
  approvedById       Int?
  approvedBy         User?             @relation("WOApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  estimatedStartDate DateTime?
  estimatedEndDate   DateTime?
  managerRemarks     String?
  
  isEscalated        Boolean           @default(false)
  escalatedAt        DateTime?
  escalatedTo        String?
  
  rejectionReason    String?
  rejectedAt         DateTime?
  rejectedById       Int?
  
  completionNotes    String?
  completedAt        DateTime?
  closedAt           DateTime?
  closedById         Int?

  // Level 3 Escalation & Maintenance Type
  maintenanceCategory String           @default("BREAKDOWN") // 'PREVENTIVE', 'PREDICTIVE', 'CONDITION', 'BREAKDOWN'
  breakdownLevel      Int              @default(1) // Level 1, Level 2, Level 3
  level1ApprovedAt    DateTime?
  level2ApprovedAt    DateTime?
  level3ApprovedAt    DateTime?
  level3ApprovedById  Int?
  level3ApprovedBy    User?            @relation("WOLevel3Approver", fields: [level3ApprovedById], references: [id], onDelete: SetNull)
  
  media              WorkOrderMedia[]
  spareParts         WorkOrderSparePart[]
  revisions          WorkOrderRevision[]
  
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model WorkOrderMedia {
  id            Int       @id @default(autoincrement())
  workOrderId   Int
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  fileUrl       String
  fileName      String
  fileType      String    // 'IMAGE', 'VIDEO', 'DOCUMENT'
  uploadedStage String    @default("INITIAL") // 'INITIAL', 'PROOF_OF_WORK', 'REVISION'
  uploadedById  Int?
  createdAt     DateTime  @default(now())
}

model SparePartMaster {
  id            Int                  @id @default(autoincrement())
  partCode      String               @unique
  adminId       Int?
  partName      String
  category      String?
  subCategory   String?
  stockQuantity Int                  @default(0)
  inHandQuantity Int                 @default(0)
  atSourceQuantity Int               @default(0)
  minimumQuantity Int?               @default(0)
  totalStock    Int?                 @default(0)
  unitOfMeasure String               @default("PCS")
  unitCost      Float                @default(0)
  rate          Float?               @default(0)
  location      String?
  stockLocation String?
  description   String?
  headOfDepartment String?
  notes         String?
  imageUrl      String?
  namePlateFile String?
  stockLocations Json?
  machinesList  Json?
  customSpecifications Json?
  warrantiesList Json?
  suppliersList Json?
  documentsList Json?
  logsList      Json?
  woSpareParts    WorkOrderSparePart[]
  scheduleSpares  MaintenanceScheduleSpare[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model WorkOrderSparePart {
  id          Int              @id @default(autoincrement())
  workOrderId Int
  workOrder   WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  sparePartId Int?
  sparePart   SparePartMaster? @relation(fields: [sparePartId], references: [id], onDelete: SetNull)
  partName    String
  partCode    String?
  quantity    Int              @default(1)
  unitCost    Float            @default(0)
  totalCost   Float            @default(0)
  createdAt   DateTime         @default(now())
}

model WorkOrderRevision {
  id                 Int       @id @default(autoincrement())
  workOrderId        Int
  workOrder          WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  requestedById      Int?
  requestedBy        User?     @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  reason             String
  previousEstEndDate DateTime?
  proposedEstEndDate DateTime?
  status             String    @default("PENDING") // 'PENDING', 'APPROVED', 'REJECTED'
  createdAt          DateTime  @default(now())
}

model MachineCheckpoint {
  id             Int      @id @default(autoincrement())
  machineId      Int
  machine        Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  title          String
  checkpointType String   // 'SAFETY', 'MECHANICAL', 'ELECTRICAL', 'LUBRICATION', 'OPERATIONAL'
  standardValue  String?
  frequency      String?  // 'DAILY', 'WEEKLY', 'MONTHLY'
  createdAt      DateTime @default(now())
}

model MaintenanceSchedule {
  id                    Int               @id @default(autoincrement())
  scheduleCode          String            @unique
  adminId               Int?
  scheduleType          String            @default("PREVENTIVE") // 'PREVENTIVE', 'PREDICTIVE', 'CONDITION', 'BREAKDOWN'
  frequency             String            @default("MONTHLY")    // 'DAILY', 'WEEKLY', 'MONTHLY', 'BIMONTHLY', 'QUARTERLY', 'HALF_YEARLY', 'YEARLY'
  priority              WorkOrderPriority @default(MEDIUM)
  status                String            @default("ACTIVE")     // 'ACTIVE', 'PAUSED', 'COMPLETED'
  
  machineId             Int
  machine               Machine           @relation(fields: [machineId], references: [id], onDelete: Cascade)
  
  mainFacilityId        Int?
  facilityId            Int?
  buildingId            Int?
  
  prePlanToleranceDays  Int               @default(1)
  postPlanToleranceDays Int               @default(1)
  triggerTime           String            @default("09:00")
  startDate             DateTime
  endDate               DateTime?
  nextRunDate           DateTime?
  lastRunDate           DateTime?
  completedBy           String?
  notes                 String?
  notifyUsers           String?           // JSON array string of user emails/IDs
  
  tasks                 MaintenanceScheduleTask[]
  spares                MaintenanceScheduleSpare[]
  logs                  MaintenanceScheduleLog[]
  
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

model MaintenanceScheduleTask {
  id                   Int                  @id @default(autoincrement())
  scheduleId           Int
  schedule             MaintenanceSchedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  description          String
  taskType             String               @default("INSPECTION") // 'INSPECTION', 'SERVICING', 'REPLACEMENT', 'CALIBRATION', 'CLEANING'
  frequency            String?
  assignedTechnicianId Int?
  assignedTechnician   User?                @relation(fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  checkpointMasterId   Int?
  checkpointMaster     CheckpointMaster?    @relation(fields: [checkpointMasterId], references: [id], onDelete: SetNull)
  standardValue        String?
  toleranceMin         Float?
  toleranceMax         Float?
  createdAt            DateTime             @default(now())
}

model MaintenanceScheduleSpare {
  id          Int                 @id @default(autoincrement())
  scheduleId  Int
  schedule    MaintenanceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  sparePartId Int?
  sparePart   SparePartMaster?    @relation(fields: [sparePartId], references: [id], onDelete: SetNull)
  partName    String
  partCode    String?
  quantity    Int                 @default(1)
  createdAt   DateTime            @default(now())
}

model MaintenanceScheduleLog {
  id          Int                 @id @default(autoincrement())
  scheduleId  Int
  schedule    MaintenanceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  action      String              // 'CREATED', 'TRIGGERED_WO', 'PAUSED', 'RESUMED', 'COMPLETED'
  details     String?
  performedBy String?
  createdAt   DateTime            @default(now())
}

model CheckpointMaster {
  id             Int                       @id @default(autoincrement())
  code           String                    @unique // e.g. 'CHK-PREV-001'
  adminId        Int?
  checkpointType String                    @default("PREVENTIVE") // 'PREVENTIVE', 'PREDICTIVE'
  description    String
  frequency      String                    @default("MONTHLY")
  unit           String?
  minValue       Float?
  maxValue       Float?
  standardValue  String?
  category       String?
  tasks          MaintenanceScheduleTask[]
  userCheckpoints UserCheckpoint[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
}

model UserCheckpoint {
  id                 Int               @id @default(autoincrement())
  checkpointMasterId Int?
  checkpointMaster   CheckpointMaster? @relation(fields: [checkpointMasterId], references: [id], onDelete: SetNull)
  machineId          Int
  machine            Machine           @relation(fields: [machineId], references: [id], onDelete: Cascade)
  userId             Int?
  user               User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  checkpointType     String
  description        String
  frequency          String
  standardValue      String?
  minValue           Float?
  maxValue           Float?
  status             String            @default("ACTIVE")
  createdAt          DateTime          @default(now())
}

model Supplier {
  id                  Int      @id @default(autoincrement())
  supplierCode        String   @unique
  adminId             Int?
  name                String
  contactPerson       String?
  email               String?
  secondaryEmail      String?
  phone               String?
  fax                 String?
  website             String?
  primaryCurrency     String?  @default("INR")
  gstNumber           String?
  address             String?
  city                String?
  state               String?
  country             String?  @default("India")
  postalCode          String?
  latitude            String?
  longitude           String?
  notes               String?
  businessCategory    String?
  businessDescription String?
  status              String   @default("ACTIVE")
  logoUrl             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model MachineOption {
  id        Int      @id @default(autoincrement())
  adminId   Int?
  type      String   // 'make', 'modelNumber', 'machineCategory', 'machineSubCategory'
  value     String
  createdAt DateTime @default(now())

  @@unique([adminId, type, value])
}
