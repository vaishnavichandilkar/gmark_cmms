generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Society {
  id        Int        @id @default(autoincrement())
  name      String
  city      String
  buildings Building[]
  users     User[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

enum UserRole {
  SUPER_ADMIN
  SOCIETY_ADMIN
  BUILDING_ADMIN
  OPERATOR
  VIEWER
}

model User {
  id              Int            @id @default(autoincrement())
  username        String         @unique
  mobileNumber    String?
  email           String         @unique
  password        String
  firstName       String?
  lastName        String?
  profileTitle    String?
  profileDetail   String?
  profileImageUrl String?
  floorNo         String?
  city            String?
  state           String?
  country         String?
  pincode         String?
  role            UserRole       @default(VIEWER)
  isActive        Boolean        @default(true)
  societyId       Int?
  society         Society?       @relation(fields: [societyId], references: [id], onDelete: Cascade)
  employeeId      Int?
  employee        Employee?      @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  mainFacilityId  Int?
  mainFacility    MainFacility?  @relation(fields: [mainFacilityId], references: [id], onDelete: SetNull)
  buildings       UserBuilding[]
  refreshToken    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model UserBuilding {
  id          Int      @id @default(autoincrement())
  userId      Int
  buildingId  Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([userId, buildingId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  module    String
  ipAddress String
  createdAt DateTime @default(now())
}

model Building {
  id        Int            @id @default(autoincrement())
  name      String
  info      String?        @default("0F - 0 flats")
  societyId Int
  society   Society        @relation(fields: [societyId], references: [id], onDelete: Cascade)
  devices   Device[]
  users     UserBuilding[]
}

model Device {
  id          Int      @id @default(autoincrement())
  deviceId    String   @unique
  name        String
  template    String?
  systemName  String?
  cardNo      String?
  topic       String?
  buildingId  Int?
  
  // Frontend integration fields
  application String?  @default("DOMESTIC_WATER_SYS")
  pumpType    String?  @default("WMP_BOOSTER_PUMP")
  controller  String?  @default("AIPCU")
  macType     String?  @default("Primary MAC")

  // Machine Management Extended Fields
  company             String?
  maintenanceHead     String?
  machineCode         String?
  serialNumber        String?
  make                String?
  modelNumber         String?
  machineCategory     String?
  machineSubCategory  String?
  description         String?
  assetCode           String?
  isLocationPart      Boolean? @default(false)
  costCenter          String?
  headOfDepartment    String?
  machineOwner        String?
  latitude            String?
  longitude           String?
  notes               String?

  
  building    Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  facilityId  Int?
  facility    Facility? @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  documents   MachineDocument[]
  specifications MachineSpecification[]

  parentDeviceId Int?
  parentDevice   Device?  @relation("DeviceHierarchy", fields: [parentDeviceId], references: [id])
  childDevices   Device[] @relation("DeviceHierarchy")
  
  latestData  Json?
  lastSeen    DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  registerValues DeviceRegisterValue[]
}

model DeviceSnapshot {
  id          Int      @id @default(autoincrement())
  deviceId    String
  payload     Json
  createdAt   DateTime @default(now())
}

model DeviceState {
  id                  Int      @id @default(autoincrement())
  deviceId            String   @unique
  deviceActive        Boolean  @default(false)
  motor1Status        Boolean  @default(false)
  motor2Status        Boolean  @default(false)
  motor3Status        Boolean  @default(false)
  motor4Status        Boolean  @default(false)
  motor1ConfigActivate Boolean  @default(false)
  motor2ConfigActivate Boolean  @default(false)
  motor3ConfigActivate Boolean  @default(false)
  motor4ConfigActivate Boolean  @default(false)
  inputPowerFaultType Int      @default(0)
  averageVoltage      Float    @default(0)
  ryVoltage           Float    @default(0)
  ybVoltage           Float    @default(0)
  rbVoltage           Float    @default(0)
  motor1RCurrent      Float    @default(0)
  motor1YCurrent      Float    @default(0)
  motor1BCurrent      Float    @default(0)
  motor2RCurrent      Float    @default(0)
  motor2YCurrent      Float    @default(0)
  motor2BCurrent      Float    @default(0)
  motor3RCurrent      Float    @default(0)
  motor3YCurrent      Float    @default(0)
  motor3BCurrent      Float    @default(0)
  motor4RCurrent      Float    @default(0)
  motor4YCurrent      Float    @default(0)
  motor4BCurrent      Float    @default(0)
  waterAvailable      Boolean  @default(false)
  pressureSwitch1     Boolean  @default(false)
  pressureSwitch2     Boolean  @default(false)
  pressureSwitch3     Boolean  @default(false)
  pressureSwitch4     Boolean  @default(false)
  pressureSwitch5     Boolean  @default(false)
  pressureBar         Float    @default(0)
  transmitterConnected Boolean  @default(false)
  pressuremA          Float    @default(0)
  pumpOnDelay         Int      @default(0)
  nextFillingTime     Int      @default(0)
  overloadResetDelay  Int      @default(0)
  underloadResetDelay Int      @default(0)
  vfdResetAfter       Int      @default(0)
  pressureTankPressure Float   @default(0)
  tankStatus          Boolean  @default(false)
  pump1FaultType      Int      @default(0)
  pump2FaultType      Int      @default(0)
  pump3FaultType      Int      @default(0)
  pump4FaultType      Int      @default(0)
  motor1RunTime       Int      @default(0)
  motor2RunTime       Int      @default(0)
  motor3RunTime       Int      @default(0)
  motor4RunTime       Int      @default(0)
  updatedAt           DateTime @updatedAt
}

model RegisterDefinition {
  id          Int      @id @default(autoincrement())
  address     Int      @unique // Array Index (0, 1, 2, etc.)
  name        String   
  range       String?  
  description String?  
  units       String?
  mappedKey   String?  // The key to update in DeviceState/Frontend
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  deviceValues DeviceRegisterValue[]
}

model DeviceRegisterValue {
  id           Int      @id @default(autoincrement())
  deviceId     String
  registerId   Int
  value        Float
  updatedAt    DateTime @updatedAt

  register     RegisterDefinition @relation(fields: [registerId], references: [id])
  device       Device             @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)

  @@unique([deviceId, registerId])
}

model Employee {
  id              Int      @id @default(autoincrement())
  employeeCode    String   @unique
  fullName        String
  mobileNumber    String
  officialEmail   String   @unique
  personalEmail   String?
  dateOfJoining   DateTime
  dateOfBirth     DateTime
  department      String
  designation     String
  salaryPayout    Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  users           User[]
}

model MainFacility {
  id               Int      @id @default(autoincrement())
  mainFacilityCode String   @unique
  mainFacilityName String
  mainFacilityHead String
  gstNumber        String?
  category         String
  subcategory      String
  status           String
  description      String?
  latitude         String?
  longitude        String?
  postalCode       String?
  address          String?
  country          String?
  state            String?
  city             String?
  users            User[]
  facilities       Facility[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Facility {
  id               Int          @id @default(autoincrement())
  facilityCode     String       @unique
  facilityName     String
  category         String
  description      String?
  
  // Location & Hierarchy Fields
  isLocationPart   Boolean      @default(false)
  parentFacilityId Int?
  parentFacility   Facility?    @relation("FacilityHierarchy", fields: [parentFacilityId], references: [id])
  childFacilities  Facility[]   @relation("FacilityHierarchy")
  
  address          String?
  country          String?
  state            String?
  city             String?
  postalCode       String?
  subCategory      String?
  latitude         String?
  longitude        String?
  facilityHeadName String?
  notes            String?
  
  mainFacilityId   Int
  mainFacility     MainFacility @relation(fields: [mainFacilityId], references: [id], onDelete: Cascade)
  devices          Device[]
  
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Designation {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  isActive    Boolean      @default(true)
  permissions Permission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id            Int         @id @default(autoincrement())
  designationId Int
  moduleId      String
  canView       Boolean     @default(false)
  canCreate     Boolean     @default(false)
  canEdit       Boolean     @default(false)
  canDelete     Boolean     @default(false)
  canImport     Boolean     @default(false)
  canExport     Boolean     @default(false)
  canPrint      Boolean     @default(false)
  designation   Designation @relation(fields: [designationId], references: [id], onDelete: Cascade)

  @@unique([designationId, moduleId])
}

model PostalCode {
  id        Int      @id @default(autoincrement())
  pincode   String   @unique
  city      String
  state     String
  country   String   @default("India")
  createdAt DateTime @default(now())

  @@index([pincode])
}

model CodeSequence {
  id        String   @id
  prefix    String
  lastValue Int      @default(0)
  padding   Int      @default(3)
  updatedAt DateTime @updatedAt
}

model MachineDocument {
  id          Int      @id @default(autoincrement())
  name        String
  type        String   // 'File', 'Link', 'Note'
  content     String   // File path, URL, or Note text
  deviceId    Int
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MachineSpecification {
  id          Int      @id @default(autoincrement())
  title       String
  inputType   String
  data        String
  unit        String?
  deviceId    Int
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
